class Solution:
    def climbStairs(self, n: int) -> int:
        # Base cases
        if n <= 2:
            return n
        
        # We only need to track the two previous values
        prev, curr = 1, 2
        
        for _ in range(3, n + 1):
            # Fibonacci-style calculation: next = prev + current
            prev, curr = curr, prev + curr
            
        return curr
